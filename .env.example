# OmegaUse-OfficeVal 固定 Hugging Face Dataset Snapshot 与 Evaluator Git Checkout。
RSI_OFFICEVAL_DATASET_ROOT=/absolute/path/to/OmegaUse-OfficeVal-Dataset
RSI_OFFICEVAL_EVALUATOR_ROOT=/absolute/path/to/OmegaUse-OfficeVal

# 只在运行时注入给 Model Gateway；Agent 只获得一次性内部令牌。请自行 export，禁止提交真实值。
RSI_PROVIDER_BASE_URL=https://api.zcloudapi.com/v1
RSI_PROVIDER_API_KEY=replace-me

# CoworkEvoBench 本地 checkout。Dataset 与 Evaluator 来自同一个仓库，
# 但保留两个变量以符合 Environment Adapter 的显式依赖接口。
RSI_COWORK_BENCH_DATASET_ROOT=/absolute/path/to/cowork-evolution-benchmark
RSI_COWORK_BENCH_EVALUATOR_ROOT=/absolute/path/to/cowork-evolution-benchmark

# 可选：为 Claude Code Updater 单独使用 Anthropic Messages 凭据。
# 与 Solver 的 RSI_PROVIDER_* 分开；Claude 可用的 Key 不一定具有 GPT 模型渠道。
# Solver 使用可调用其指定模型的 Key，不要把真实 Key 写入 Experiment/Adapter。
RSI_CLAUDE_PROVIDER_BASE_URL=https://api.zcloudapi.com/v1
RSI_CLAUDE_PROVIDER_API_KEY=replace-me
