{
  "apiVersion": "harness-rsi/v1alpha1",
  "kind": "BaselineExperiment",
  "method": "evo-bench-paper",
  "policy": "evaluation/policies/cowork-bench-evobench-validation.json",
  "benchmark": "benchmarks/cowork-bench-native-90-30-60/benchmark.json",
  "candidateBudget": 4,
  "maximumConcurrentTrials": 30,
  "feedbackTraversal": "full-pass",
  "finalCandidates": "winner-only",
  "evoBenchProtocol": {
    "validationPartition": "selection",
    "evaluationPartition": "final",
    "maxIterations": 4,
    "maxSteps": 1000
  },
  "seed": 20260910,
  "maximumReflectionRounds": 3,
  "maximumUpdaterRequests": 1000,
  "maximumSolverRequests": 32768,
  "maximumWallSeconds": 172800,
  "adapters": {
    "target": "adapters/targets/msa-minimal-cowork-rsi.yml",
    "updater": "adapters/updaters/codex-cli.yml",
    "provider": "adapters/providers/zcloud-openai.yml",
    "infrastructure": "environments/cowork-bench-agentbay.yml"
  },
  "models": {
    "solver": { "provider": "zcloud-openai", "model": "gpt-5.6-terra", "maxTokens": 65536, "reasoningEffort": "high" },
    "updater": { "provider": "zcloud-openai", "model": "gpt-5.6-terra", "maxTokens": 65536, "reasoningEffort": "high" }
  }
}
