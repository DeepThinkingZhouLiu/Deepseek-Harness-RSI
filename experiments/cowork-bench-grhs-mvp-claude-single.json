{
  "apiVersion": "harness-rsi/v1alpha1",
  "kind": "EvolutionExperiment",
  "metadata": { "id": "cowork-bench-grhs-mvp-claude-single" },
  "spec": {
    "recipe": "recipes/population-grhs-mvp/single.yml",
    "adapters": {
      "target": "adapters/targets/msa-minimal-cowork-rsi.yml",
      "updater": "adapters/updaters/claude-code-cli.yml",
      "environment": "environments/cowork-bench.yml",
      "providers": {
        "solver": "adapters/providers/zcloud-openai.yml",
        "updater": "adapters/providers/zcloud-anthropic.yml"
      },
      "strategy": "adapters/strategies/group-relative-harness.yml"
    },
    "benchmark": "benchmarks/cowork-bench-smoke/benchmark.json",
    "policy": "evaluation/policies/cowork-officeval-rsi.json",
    "models": {
      "solver": {
        "provider": "zcloud-openai",
        "model": "gpt-5.6-terra",
        "maxTokens": 8192,
        "reasoningEffort": "high"
      },
      "updater": {
        "provider": "zcloud-anthropic",
        "model": "claude-sonnet-5",
        "maxTokens": 8192,
        "reasoningEffort": "high"
      }
    },
    "evolution": {
      "mutationLevel": "l3",
      "generations": 1,
      "trialsPerInstance": 1,
      "seeds": [20260906]
    }
  }
}
